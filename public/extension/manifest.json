{
  "manifest_version": 3,
  "name": "اشک ۲۴ - سامانه یکپارچه انتشار هوشمند آگهی و مدیریت سشن",
  "version": "5.9.40",
  "description": "موتور یکپارچه انتشار خودکار آگهی در دایرکتوری‌های ایرانی با IP بومی و دورزدن پایدار فیلترینگ و تحریم‌ها",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "alarms",
    "scripting",
    "webNavigation",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "افزونه خودمختار استخراج سشن اشک ۲۴",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
